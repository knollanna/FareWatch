# Supabase — find these in your Supabase project settings under "API"
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Duffel API — get your token from the Duffel dashboard (flights)
DUFFEL_API_TOKEN=

# LiteAPI / Nuitée — hotels. Sign up at liteapi.travel, grab a sandbox key from
# the dashboard, and paste it here. Same X-API-Key header for sandbox and prod;
# the key itself decides which. Searches are free (they monetise bookings).
LITEAPI_KEY=

# The public URL of your deployed app (used in client email links)
BASE_URL=

# SendGrid — get your API key from sendgrid.com
SENDGRID_API_KEY=
# The email address alerts are sent from — must be verified in SendGrid
SENDER_EMAIL=

# A password you choose — anyone who knows this can log into FareWatch
APP_PASSWORD=

# Flask secret key — any long random string works (used to secure login sessions)
FLASK_SECRET_KEY=

# Render API key (optional) — powers live status + last-deploy on the usage page.
# Create at Render dashboard → Account Settings → API Keys. Leave blank to fall
# back to a dashboard link.
RENDER_API_KEY=

# Slack incoming webhook (optional) — sends a Slack alert alongside the email
# when a fare hits target. Create at api.slack.com/apps. Leave blank to skip.
SLACK_WEBHOOK_URL=
